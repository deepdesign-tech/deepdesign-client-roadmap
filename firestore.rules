rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function hasMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function activeMember() {
      return hasMember()
        && (!member().data.keys().hasAny(['active']) || member().data.active == true);
    }

    // DeepDesign admin is global across Roadmap projects.
    function isAdmin() {
      return activeMember() && member().data.role == 'admin';
    }

    function assigned(projectId) {
      return activeMember()
        && member().data.projects is list
        && projectId in member().data.projects;
    }

    function editor(projectId) {
      return assigned(projectId) && member().data.role == 'editor';
    }

    function validProjectShape() {
      return request.resource.data.keys().hasAll(['name', 'phases', 'kpi', 'notes'])
        && request.resource.data.keys().hasOnly([
          'name', 'phases', 'phaseDefinitions', 'phaseSchemaVersion',
          'kpi', 'notes', 'status', 'createdAt', 'createdBy', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.phases is map
        && request.resource.data.kpi is map
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 10000
        && (!request.resource.data.keys().hasAny(['phaseDefinitions'])
          || (request.resource.data.phaseDefinitions is list
            && request.resource.data.phaseDefinitions.size() <= 30))
        && (!request.resource.data.keys().hasAny(['phaseSchemaVersion'])
          || request.resource.data.phaseSchemaVersion is int)
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['active', 'paused', 'archived']);
    }

    function validManagedMember() {
      return request.resource.data.keys().hasAll(['email', 'role', 'projects', 'active'])
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'projects', 'active',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['viewer', 'editor']
        && request.resource.data.projects is list
        && request.resource.data.projects.size() <= 100
        && request.resource.data.active is bool
        && (!request.resource.data.keys().hasAny(['displayName'])
          || request.resource.data.displayName is string);
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && uid != request.auth.uid
        && validManagedMember()
        && request.resource.data.projects.size() > 0;

      allow update: if isAdmin()
        && uid != request.auth.uid
        && resource.data.role != 'admin'
        && validManagedMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'role', 'projects', 'active', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /projects/{projectId} {
      // Admin sees every project; clients only projects assigned in their member record.
      allow get: if isAdmin() || assigned(projectId);
      allow list: if isAdmin();

      // Admin can create a project and define its dynamic Roadmap structure.
      allow create: if isAdmin() && validProjectShape();

      // Only Admin can change project settings / phaseDefinitions.
      // Editors can update progress, KPI and notes but cannot alter the Roadmap structure.
      allow update: if (isAdmin() && validProjectShape())
        || (editor(projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phases', 'kpi', 'notes', 'updatedAt'
          ])
          && validProjectShape());

      // Permanent deletion is restricted to a signed-in DeepDesign admin.
      // The Admin Console additionally requires the project to be Archived and typed confirmation.
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
